# ==========================
# PrincessVerse MERN .gitignore
# ==========================

# Node modules
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment files (Never push secrets)
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Uploads (Local uploaded images/videos)
backend/uploads/
backend/uploads/profile/
backend/uploads/memories/
backend/uploads/gallery/
backend/uploads/temp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# OS files
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Build folders
frontend/dist/
backend/dist/
build/

# Coverage
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo

# Render / Vercel
.vercel/
.render/

# Package manager
.pnpm-store/